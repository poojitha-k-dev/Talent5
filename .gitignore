# Dependencies & Build artifacts
node_modules/
.next/
dist/
build/
*.tsbuildinfo

# Environment variables & secrets (Never commit secrets)
.env
.env.*
.env*.local
**/.env
**/.env.*
**/.env*.local
!.env.example
!**/.env.example

# Logs & OS artifacts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
*.pem

# Media & assets
public/uploads/*
!public/uploads/.gitkeep
apps/web/public/media/*.mp3
apps/web/public/media/media/
!apps/web/public/media/.gitkeep

