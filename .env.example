# Talent5 Production-Ready Environment Variables
NODE_ENV=development
PORT=3000
API_PORT=4000
WEB_PORT=3000

# Base URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
# CORS allowlist (comma-separated). Only these browser origins are permitted.
CORS_ORIGINS=http://localhost:3000,http://localhost:4000

# PostgreSQL Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=talent5_v1
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/talent5_v1

# JWT Secrets & Session Security
# Required, min 32 chars. Generate with: openssl rand -base64 48
JWT_SECRET=replace_with_strong_random_value_at_least_32_chars
JWT_EXPIRATION=7d
REFRESH_TOKEN_SECRET=replace_with_strong_random_value
REFRESH_TOKEN_EXPIRATION=30d

# Payment gateway webhook HMAC secret (required to verify payout webhooks)
PAYMENT_WEBHOOK_SECRET=replace_with_webhook_secret_from_gateway

# Media Storage Architecture
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./public/uploads
AWS_REGION=ap-south-1
AWS_S3_BUCKET=talent5-assets
AWS_ACCESS_KEY_ID=mock_access_key
AWS_SECRET_ACCESS_KEY=mock_secret_key

# Creator Economics & Anti-Fraud Configuration
DEFAULT_REWARD_PER_VALID_LIKE_INR=0.10
MINIMUM_PAYOUT_INR=500.00
FRAUD_RISK_THRESHOLD=75

# Seed Admin Credentials (set a strong, unique password before seeding)
SEED_ADMIN_EMAIL=admin@talent5.com
SEED_ADMIN_PASSWORD=replace_with_strong_admin_password
