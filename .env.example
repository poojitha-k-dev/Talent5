# Talent5 Production-Ready Environment Variables
NODE_ENV=development
PORT=3000
API_PORT=4000
WEB_PORT=3000

# Base URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:4000

# PostgreSQL Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=talent5_v1
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/talent5_v1

# JWT Secrets & Session Security
JWT_SECRET=talent5_super_secure_jwt_secret_key_2026_desi_music_platform_ultra
JWT_EXPIRATION=7d
REFRESH_TOKEN_SECRET=talent5_refresh_token_secret_key_2026_desi_platform_refresh
REFRESH_TOKEN_EXPIRATION=30d

# Media Storage Architecture
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./public/uploads
AWS_REGION=ap-south-1
AWS_S3_BUCKET=talent5-assets
AWS_ACCESS_KEY_ID=mock_access_key
AWS_SECRET_ACCESS_KEY=mock_secret_key

# Creator Economics & Anti-Fraud Configuration
DEFAULT_REWARD_PER_VALID_LIKE_INR=0.10
MINIMUM_PAYOUT_INR=500.00
FRAUD_RISK_THRESHOLD=75

# Seed Admin Credentials
SEED_ADMIN_EMAIL=admin@talent5.com
SEED_ADMIN_PASSWORD=Talent5Admin2026!
