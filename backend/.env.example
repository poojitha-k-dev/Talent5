# Talent5 Backend Environment Variables Example
# Copy this file to .env: cp .env.example .env

NODE_ENV=development
PORT=5000
BACKEND_PORT=5000
FRONTEND_URL=http://localhost:3000

# CORS allowlist (comma-separated). Primary source of allowed browser origins.
# FRONTEND_URL and NEXT_PUBLIC_APP_URL are used as fallbacks if this is empty.
CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# PostgreSQL Database Configuration (Supabase Cloud or Local PostgreSQL)
# Required. The app will refuse to start if DATABASE_URL is unset.
DATABASE_URL="postgresql://user:password@host:port/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# TLS for remote databases: certificate verification is ALWAYS enforced.
# If your managed provider's CA is not in Node's trust store, supply it here.
# Provide EITHER the PEM contents inline OR a path to a PEM file (not both).
# Used by both the app and the maintenance scripts in /scripts.
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# DATABASE_CA_CERT_FILE=/etc/ssl/certs/supabase-ca.pem

# Source DB for the local->Supabase migration script (scripts/migrate_to_supabase.mjs).
# Defaults to the local dev database if unset.
# SOURCE_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/talent5_v1"

# Supabase Storage Configuration
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=../frontend/public/media

# JWT Secrets & Security
# Required. Must be a strong, random value of at least 32 characters.
# Generate one with: openssl rand -base64 48
JWT_SECRET=replace_with_strong_random_value_at_least_32_chars
JWT_EXPIRATION=7d
REFRESH_TOKEN_SECRET=your_refresh_token_secret_key
REFRESH_TOKEN_EXPIRATION=30d

# Payment gateway webhook HMAC secret. Required to verify payout webhooks.
PAYMENT_WEBHOOK_SECRET=replace_with_webhook_secret_from_gateway

# Local-only developer conveniences (OFF by default; ignored in production).
# ENABLE_MOCK_AUTH=true enables /auth/google?mock=true (auth bypass for testing).
# EXPOSE_DEV_OTP=true returns the password-reset OTP in the API response.
# ENABLE_MOCK_AUTH=false
# EXPOSE_DEV_OTP=false

# Email Delivery Configuration (Optional)
EMAIL_USER=your_email@gmail.com
EMAIL_APP_PASSWORD=your_gmail_app_password
EMAIL_FROM="Talent5 Support <your_email@gmail.com>"

# Resend API Configuration (Optional)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM="Talent5 Support <onboarding@resend.dev>"

# Creator Economics & Anti-Fraud
DEFAULT_REWARD_PER_VALID_LIKE_INR=0.10
MINIMUM_PAYOUT_INR=500.00
FRAUD_RISK_THRESHOLD=75

# Seed Admin Credentials
SEED_ADMIN_EMAIL=admin@talent5.com
SEED_ADMIN_PASSWORD=your_admin_password
