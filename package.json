{
  "name": "talent5",
  "version": "1.0.0",
  "private": true,
  "description": "Talent5 - Real Voices. Original Stories. Desi Talent.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm --workspace=apps/backend run dev\" \"npm --workspace=apps/frontend run dev\"",
    "dev:frontend": "npm --workspace=apps/frontend run dev",
    "dev:backend": "npm --workspace=apps/backend run dev",
    "dev:web": "npm --workspace=apps/frontend run dev",
    "build": "npm run build --workspaces --if-present",
    "build:frontend": "npm --workspace=apps/frontend run build",
    "build:backend": "npm --workspace=apps/backend run build",
    "start:frontend": "npm --workspace=apps/frontend run start",
    "start:backend": "npm --workspace=apps/backend run start",
    "test": "node scripts/run-tests.js",
    "db:init": "node infrastructure/database/init-db.js",
    "db:seed": "node infrastructure/database/seed-db.js",
    "postinstall": "prisma skills sync || exit 0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "prisma": "^8.0.0-rc.17",
    "typescript": "^5.6.3"
  }
}
