{
  "name": "talent5",
  "version": "1.0.0",
  "private": true,
  "description": "Talent5 - Real Voices. Original Stories. Desi Talent.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm --workspace=apps/web run dev",
    "dev:all": "concurrently \"npm --workspace=apps/web run dev\" \"npm --workspace=apps/api run dev\"",
    "build": "npm run build --workspaces --if-present",
    "build:web": "npm --workspace=apps/web run build",
    "start:web": "npm --workspace=apps/web run start",
    "test": "node scripts/run-tests.js",
    "db:init": "node infrastructure/database/init-db.js",
    "db:seed": "node infrastructure/database/seed-db.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.6.3"
  }
}
